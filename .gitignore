cat > .gitignore << 'EOF'
# Virtual environments
.venv/
venv/
env/

# Python bytecode and packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Project outputs (runs, checkpoints, figures generated by the code)
runs/
outputs/
checkpoints/
*.pt
*.pth

# Editors and OS
.vscode/
.idea/
.DS_Store
EOF
